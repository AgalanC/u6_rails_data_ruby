<%# <div>
  <h1 class="font-bold text-4xl">Trophies#index</h1>
  <p>Find me in app/views/trophies/index.html.erb</p>
</div> %>

<h1>Trophies</h1>

<%= form_with url: trophies_path, method: :get, local: true do %>
  <%= label_tag :search, "Search for trophies by name:" %>
  <%= text_field_tag :search, params[:search] %>
  <%= submit_tag "Search" %>
<% end %>

<table>
  <thead>
    <tr>
      <th>Year</th>
      <th>Trophy Name</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @trophies.each do |trophy| %>
      <tr>
        <td><%= trophy.year %></td>
        <td><%= trophy.trophy_name %></td>
        <td><%= link_to 'Show', trophy_path(trophy) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @trophies %>

