<%# <div>
  <h1 class="font-bold text-4xl">Players#index</h1>
  <p>Find me in app/views/players/index.html.erb</p>
</div> %>

<h1>Players</h1>

<%= form_with url: players_path, method: :get, local: true do %>
  <%= label_tag :search, "Search for players by name:" %>
  <%= text_field_tag :search, params[:search] %>

  <%= label_tag :team_id, "Filter by team:" %>
  <%= select_tag :team_id, options_from_collection_for_select(@teams, :id, :team_name, params[:team_id]), include_blank: true %>

  <%= submit_tag "Search" %>
<% end %>

<table>
  <thead>
    <tr>
      <th>Jersey Number</th>
      <th>Player Name</th>
      <th>Team</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @players.each do |player| %>
      <tr>
        <td><%= player.jersey_number %></td>
        <td><%= player.player_name %></td>
        <td><%= player.team.team_name %></td>
        <td><%= link_to 'Show', player_path(player) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @players %>

