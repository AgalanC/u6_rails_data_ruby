<%# <div>
  <h1 class="font-bold text-4xl">Teams#index</h1>
  <p>Find me in app/views/teams/index.html.erb</p>
</div> %>

<h1>Teams</h1>
<table>
  <thead>
    <tr>
      <th>Team Name</th>
      <th>Coach</th>
    </tr>
  </thead>
  <tbody>
    <% @teams.each do |team| %>
      <tr>
        <td><%= team.team_name %></td>
        <td><%= team.coach %></td>
      </tr>
    <% end %>
  </tbody>
</table>
